#!/usr/bin/env python3

import os
import sys
import json
import hashlib
import difflib
from pathlib import Path
from datetime import datetime
import argparse

HOME = Path.home()
GLOBAL_IGNORE = {".git", ".dotctl", "__pycache__"}


# =========================
# Paths internos
# =========================
def dotctl_dir(repo):
    return repo / ".dotctl"

def config_path(repo):
    return dotctl_dir(repo) / "config.json"

def state_path(repo):
    return dotctl_dir(repo) / "state.json"

def log_path(repo):
    return dotctl_dir(repo) / "logs.txt"


# =========================
# LOGS
# =========================
def log(repo, msg):
    path = log_path(repo)
    path.parent.mkdir(parents=True, exist_ok=True)

    with path.open("a", encoding="utf-8") as f:
        f.write(f"[{datetime.now().isoformat()}] {msg}\n")


# =========================
# CONFIG
# =========================
def load_config(repo):
    cfg = config_path(repo)
    if cfg.exists():
        return json.loads(cfg.read_text())

    return {
        "profile": "default",
        "profiles": {
            "default": {
                "include": [],
                "ignore": [".git", ".dotctl"],
                "exclude_patterns": []
            }
        }
    }


def get_profile(cfg):
    name = cfg.get("profile", "default")
    return cfg["profiles"][name]


# =========================
# STATE
# =========================
def load_state(repo):
    path = state_path(repo)
    if path.exists():
        data = json.loads(path.read_text())
        # migrate old format: {"dst": "src"} → {"dst": {"src": "src", "hash": null}}
        migrated = False
        for dst, val in list(data.items()):
            if isinstance(val, str):
                data[dst] = {"src": val, "hash": None}
                migrated = True
        if migrated:
            save_state(repo, data)
        return data
    return {}


def entry_src(entry):
    return entry if isinstance(entry, str) else entry["src"]


def entry_hash(entry):
    return None if isinstance(entry, str) else entry.get("hash")


def save_state(repo, state):
    path = state_path(repo)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(state, indent=2))


# =========================
# RULES
# =========================
def is_ignored(path, repo, profile):
    rel = str(path.relative_to(repo))

    # global ignore (hard safety)
    if any(part in GLOBAL_IGNORE for part in path.parts):
        return True

    # config ignore
    for i in profile["ignore"]:
        if rel.startswith(i):
            return True

    # patterns
    for pattern in profile["exclude_patterns"]:
        if Path(rel).match(pattern):
            return True

    return False


def is_included(path, repo, profile):
    if not profile["include"]:
        return True

    rel = str(path.relative_to(repo))
    return any(rel == i or rel.startswith(i + "/") for i in profile["include"])


# =========================
# SAFETY / OWNERSHIP
# =========================
def is_managed_symlink(dst, state):
    return str(dst) in state


# =========================
# CORE SYMLINK
# =========================
def link(src, dst, state, repo, force=False, dry_run=False):
    # ya está correcto
    if dst.is_symlink() and dst.resolve() == src.resolve():
        return

    # archivo real existe
    if dst.exists() and not dst.is_symlink():
        if not force:
            print(f"[PLAN] SKIP {dst}" if dry_run else f"[SKIP] {dst}")
            return

        if dry_run:
            print(f"[PLAN] BACKUP {dst} -> {dst}.bak / LINK {dst} -> {src}")
            return

        backup = dst.with_name(dst.name + ".bak")
        n = 1
        while backup.exists():
            backup = dst.with_name(dst.name + f".bak.{n}")
            n += 1
        dst.rename(backup)
        log(repo, f"BACKUP {dst} -> {backup}")
        print(f"[BACKUP] {dst} -> {backup}")

    # symlink (nuevo o reemplazo)
    if dry_run:
        print(f"[PLAN] LINK {dst} -> {src}")
        return

    dst.parent.mkdir(parents=True, exist_ok=True)
    if dst.exists():
        dst.unlink()

    os.symlink(src, dst)

    file_hash = hashlib.sha256(src.read_bytes()).hexdigest()
    state[str(dst)] = {"src": str(src), "hash": file_hash}

    log(repo, f"LINK {dst} -> {src}")
    print(f"[LINK] {dst}")


# =========================
# REMOVE (PRUNE)
# =========================
def prune(repo, state):
    removed = 0
    missing = []

    for dst, entry in list(state.items()):
        dst_path = Path(dst)
        src_path = Path(entry_src(entry))

        if not is_managed_symlink(dst_path, state):
            continue

        # no existe en disco → limpiar state
        if not os.path.lexists(dst_path):
            state.pop(dst, None)
            continue

        # archivo real (no symlink) → seguridad, no tocar
        if not dst_path.is_symlink():
            continue

        # symlink (válido o roto) pero src ya no está en repo
        if not src_path.exists():
            missing.append((dst, entry, dst_path))
            state.pop(dst, None)

    # rename detection: match missing sources by hash
    if missing:
        repo_hashes = {}
        for p in repo.rglob("*"):
            if p.is_dir():
                continue
            try:
                h = hashlib.sha256(p.read_bytes()).hexdigest()
                repo_hashes[h] = p
            except Exception:
                pass

        for dst, entry, dst_path in missing:
            old_hash = entry_hash(entry)
            # try to compute hash from actual content if not stored
            if old_hash is None:
                try:
                    target = dst_path.resolve()
                    if target.exists():
                        old_hash = hashlib.sha256(target.read_bytes()).hexdigest()
                except Exception:
                    pass

            match = repo_hashes.get(old_hash) if old_hash else None
            if match and str(match) != entry_src(entry):
                # rename detected: content moved to new path in repo
                old_rel = Path(entry_src(entry)).relative_to(repo)
                new_rel = match.relative_to(repo)
                print(f"[RENAME] {old_rel} -> {new_rel}  (same content)")
            # prune: delete broken symlink, clean state
            dst_path.unlink()
            print(f"[PRUNE] {dst_path}")
            removed += 1

    return removed


# =========================
# SNAPSHOT (ROLLBACK)
# =========================
def snapshot(repo):
    state = load_state(repo)
    snap_dir = dotctl_dir(repo) / "snapshots"
    snap_dir.mkdir(parents=True, exist_ok=True)

    ts = datetime.now().strftime("%Y%m%d-%H%M%S")
    snap_file = snap_dir / f"{ts}.json"

    snap_file.write_text(json.dumps(state, indent=2))
    log(repo, f"SNAPSHOT {snap_file}")
    print(f"[SNAPSHOT] {snap_file}")


def rollback(repo, snapshot_name):
    snap_file = dotctl_dir(repo) / "snapshots" / snapshot_name

    if not snap_file.exists():
        print("snapshot not found")
        return

    target_state = json.loads(snap_file.read_text())
    current_state = load_state(repo)

    # revert current links
    for dst in current_state.keys():
        dst_p = Path(dst)
        if dst_p.exists() and dst_p.is_symlink():
            dst_p.unlink()

    # restore snapshot (handle both old string and new dict format)
    for dst, entry in target_state.items():
        dst_p = Path(dst)
        src = entry if isinstance(entry, str) else entry["src"]
        src_p = Path(src)

        dst_p.parent.mkdir(parents=True, exist_ok=True)

        if dst_p.exists():
            continue

        os.symlink(src_p, dst_p)

    save_state(repo, target_state)
    log(repo, f"ROLLBACK {snapshot_name}")
    print(f"[ROLLBACK] {snapshot_name}")


# =========================
# SYNC
# =========================
def sync(repo, force=False, dry_run=False):
    cfg = load_config(repo)
    profile = get_profile(cfg)
    state = load_state(repo)

    if dry_run:
        print(f"SYNC --dry-run profile: {cfg['profile']}")
    else:
        print(f"SYNC profile: {cfg['profile']}")
        log(repo, f"SYNC start profile={cfg['profile']}")

    for path in repo.rglob("*"):
        if path.is_dir():
            continue

        if is_ignored(path, repo, profile):
            continue

        if not is_included(path, repo, profile):
            continue

        rel = path.relative_to(repo)
        dst = HOME / rel

        link(path, dst, state, repo, force=force, dry_run=dry_run)

    if dry_run:
        print("\n[DRY-RUN] no se realizaron cambios. usa sync sin --dry-run para aplicar.")
        return

    prune(repo, state)
    save_state(repo, state)

    log(repo, "SYNC end")


# =========================
# DIFF
# =========================
def diff(repo):
    cfg = load_config(repo)
    profile = get_profile(cfg)
    state = load_state(repo)
    changes = 0

    for path in sorted(repo.rglob("*"), key=lambda p: str(p.relative_to(repo))):
        if path.is_dir():
            continue

        if is_ignored(path, repo, profile):
            continue

        if not is_included(path, repo, profile):
            continue

        rel = path.relative_to(repo)
        dst = HOME / rel

        if not dst.exists():
            print(f"[MISSING] {rel}")
            changes += 1
            continue

        if dst.is_symlink() and dst.resolve() == path.resolve():
            continue

        if dst.is_symlink():
            print(f"[WRONG]   {rel} -> {dst.resolve()} (expected {path})")
            changes += 1
            continue

        try:
            src_text = path.read_text(encoding="utf-8", errors="replace")
            dst_text = dst.read_text(encoding="utf-8", errors="replace")
        except Exception:
            print(f"[BINARY]  {rel}")
            changes += 1
            continue

        if src_text == dst_text:
            continue

        print(f"[DIFF]    {rel}")

        src_lines = src_text.splitlines(keepends=True)
        dst_lines = dst_text.splitlines(keepends=True)

        for line in difflib.unified_diff(
            dst_lines,
            src_lines,
            fromfile=str(dst),
            tofile=str(path),
            lineterm=""
        ):
            print(line)

        changes += 1

    if changes == 0:
        print("Everything is up to date.")
    else:
        print(f"\n{changes} file(s) differ.")


# =========================
# INIT
# =========================
def init(repo):
    dotctl = dotctl_dir(repo)
    if dotctl.exists():
        print(f"[INIT] ya existe {dotctl}")
        return

    dotctl.mkdir(parents=True)

    cfg = {
        "profile": "default",
        "profiles": {
            "default": {
                "include": [],
                "ignore": [".git", ".dotctl"],
                "exclude_patterns": []
            }
        }
    }
    (dotctl / "config.json").write_text(json.dumps(cfg, indent=2) + "\n")
    (dotctl / "state.json").write_text("{}\n")
    (dotctl / "logs.txt").write_text("")

    print(f"[INIT] repo inicializado en {repo}")


# =========================
# STATUS
# =========================
def status(repo):
    cfg = load_config(repo)
    print("profile:", cfg["profile"])
    print("state:", len(load_state(repo)))


# =========================
# REPO RESOLVER
# =========================
def resolve_repo_or_exit(args):
    if args.repo:
        return Path(args.repo)

    cwd = Path.cwd()
    if (cwd / ".dotctl").exists():
        return cwd

    print("error: repo de dotfiles no encontrado. usa -r <ruta> o ejecuta el script dentro del repo", file=sys.stderr)
    sys.exit(1)


# =========================
# CLI
# =========================
def cmd_sync(args):
    sync(resolve_repo_or_exit(args), force=args.force, dry_run=args.dry_run)

def cmd_status(args):
    status(resolve_repo_or_exit(args))

def cmd_snapshot(args):
    snapshot(resolve_repo_or_exit(args))

def cmd_rollback(args):
    rollback(resolve_repo_or_exit(args), args.snapshot)

def cmd_prune(args):
    repo = resolve_repo_or_exit(args)
    prune(repo, load_state(repo))

def cmd_diff(args):
    diff(resolve_repo_or_exit(args))

def cmd_init(args):
    repo = Path(args.repo) if args.repo else Path.cwd()
    init(repo)


def main():
    parser = argparse.ArgumentParser(
        prog="dotctl",
        description="Dotfiles manager CLI"
    )

    parser.add_argument(
        "-r", "--repo",
        help="ruta del repo de dotfiles (por defecto: directorio actual si contiene .dotctl)"
    )

    sub = parser.add_subparsers(dest="command", required=True)

    p_sync = sub.add_parser("sync")
    p_sync.add_argument("-f", "--force", action="store_true", help="reemplaza archivos reales existentes (backup .bak)")
    p_sync.add_argument("--dry-run", action="store_true", help="muestra el plan sin ejecutar cambios")
    p_sync.set_defaults(func=cmd_sync)

    sub.add_parser("status").set_defaults(func=cmd_status)
    sub.add_parser("snapshot").set_defaults(func=cmd_snapshot)

    p = sub.add_parser("rollback")
    p.add_argument("snapshot")
    p.set_defaults(func=cmd_rollback)

    sub.add_parser("prune").set_defaults(func=cmd_prune)
    sub.add_parser("diff").set_defaults(func=cmd_diff)
    sub.add_parser("init").set_defaults(func=cmd_init)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
