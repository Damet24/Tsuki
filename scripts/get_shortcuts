#!/usr/bin/env python3
import json
import sys
from pathlib import Path

file_path = Path(__file__).parent / "shortcuts.txt"

if not file_path.exists():
    print("[]")
    sys.exit(0)

shortcuts = []
for line in file_path.read_text().strip().splitlines():
    line = line.strip()
    if not line or line.startswith("#"):
        continue
    parts = line.split(maxsplit=1)
    if len(parts) == 2:
        url, icon = parts
        shortcuts.append({"url": url, "icon": icon})

print(json.dumps(shortcuts))
