{
    "exclusive": true,
    "reload_style_on_change": true,
    "position": "bottom",
    "mod": "dock",
    "passthrough": false,
    "gtk-layer-shell": true,
    "width": 600,
    "height": 40,
    "margin-top": 0,
    "margin-bottom": 0,
    "modules-left": [
        "custom/home",
        "custom/separator",
        "hyprland/workspaces",
        "custom/separator",
        "custom/waybar-position",
        "custom/voxtype",
        "custom/idle-indicator",
        "custom/notification-silencing-indicator",
        "custom/screenrecording-indicator",
        "idle_inhibitor",
        "tray",
        "custom/update",
        "custom/updatespacman",
        "power-profiles-daemon",
        "bluetooth",
        "network"
    ],
    "modules-center": [
        "mpris"
    ],
    "modules-right": [
        "custom/separator",
        "backlight",
        "pulseaudio",
        "memory",
        "cpu",
        "custom/separator",
        "custom/weather",
        "custom/clock",
        "custom/separator2",
        "battery",
        "custom/separator",
        "custom/end-history"
    ],
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "on-click": "hyprctl dispatch workspace {id}",
        "format": "{icon}",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六",
            "7": "七",
            "8": "八",
            "9": "九",
            "10": "十",
            "default": "◉"
        },
        "persistent-workspaces": {
            "*": 6
        }
    },
    "custom/waybar-position": {
        "format": "󱕐",
        "on-click": "sed -i 's/\"position\": \"top\"/\"tmp\"/;s/\"position\": \"bottom\"/\"position\": \"top\"/;s/\"tmp\"/\"position\": \"bottom\"/' ~/.config/waybar/current/config.jsonc && pkill -USR2 waybar",
        "tooltip-format": "Change Position TOP / BOTTOM"
    },
    "custom/separator": {
        "format": "|",
        "tooltip": false
    },
    "custom/separator2": {
        "exec": "sh -c '[ -d /sys/class/backlight ] && [ \"$(ls -A /sys/class/backlight 2>/dev/null)\" ] && ls /sys/class/power_supply 2>/dev/null | grep -q \"^BAT\" && echo \"|\"'",
        "tooltip": false,
        "interval": "once"
    },
    "custom/weather": {
        "format": "{}°",
        "tooltip": true,
        "interval": 60,
        "exec": "wttrbar --nerd --location Chongqing",
        "return-type": "json"
    },
    "custom/home": {
        "format": "⻯",
        "on-click": "~/.config/eww/launch_left",
        "on-click-right": "xdg-terminal-exec",
        "tooltip-format": "System menu\n\nSuper + Space"
    },
    "custom/update": {
        "format": "",
        "exec": "",
        "on-click": "",
        "tooltip-format": "",
        "signal": 7,
        "interval": 21600
    },
    "cpu": {
        "interval": 5,
        "format": " {usage:02}%",
        "on-click": "",
        "states": {
            "warning": 50,
            "critical": 80
        }
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon}",
        "tooltip": true,
        "tooltip-format": "Brightness:  {percent}%",
        "format-alt": "{percent}% {icon}",
        "format-alt-click": "click-right",
        "format-icons": [
            "󰃜",
            "󰃝",
            "󰃞",
            "󰃟",
            "󰃠"
        ],
        "on-scroll-down": "brightnessctl s 5%-",
        "on-scroll-up": "brightnessctl s +5%"
    },
    "memory": {
        "interval": 5,
        "format": " {used:0.1f}\u2009GiB",
        "tooltip-format": "Used {percentage}%\n{used:0.1f}GB/{total:0.1f}GB",
        "on-click": "",
        "states": {
            "warning": 50,
            "critical": 80
        }
    },
    "custom/clock": {
        "exec": "date +'%H:%M\u2009%p' | tr '[:upper:]' '[:lower:]'",
        "interval": 60,
        "tooltip": false,
        "on-click-right": ""
    },
    "network": {
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "format": "{icon} {essid}",
        "format-wifi": "{icon} {essid}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮",
        "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 3,
        "spacing": 1,
        "on-click": ""
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-discharging": "{capacity}% {icon}",
        "format-charging": "{capacity}% {icon}",
        "format-plugged": "",
        "format-icons": {
            "charging": [
                "󰢜",
                "󰂆",
                "󰂇",
                "󰂈",
                "󰢝",
                "󰂉",
                "󰢞",
                "󰂊",
                "󰂋",
                "󰂅"
            ],
            "default": [
                "󰁺",
                "󰁻",
                "󰁼",
                "󰁽",
                "󰁾",
                "󰁿",
                "󰂀",
                "󰂁",
                "󰂂",
                "󰁹"
            ]
        },
        "format-full": "󰂅",
        "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
        "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
        "interval": 5,
        "on-click": "",
        "on-click-right": "notify-send -u low \"$()\"",
        "states": {
            "warning": 20,
            "critical": 10
        }
    },
    "bluetooth": {
        "format": "{num_connections}",
        "format-disabled": "󰂲 {status}",
        "format-connected": "󰂱 {num_connections}",
        "tooltip-format": "Devices connected: {num_connections}",
        "on-click": ""
    },
    "pulseaudio": {
        "format": "{icon}",
        "on-click": "",
        "on-click-right": "pamixer -t",
        "tooltip-format": "Playing at {volume}%",
        "scroll-step": 5,
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "headset": "",
            "default": [
                "",
                "",
                ""
            ]
        }
    },
    "mpris": {
        "format": "  {dynamic}",
        "format-paused": " {status_icon} {dynamic}",
        "interval": 1,
        "dynamic-order": [
            "artist",
            "position",
            "length"
        ],
        "dynamic-importance-order": [
            "position",
            "length",
            "artist"
        ],
        "tooltip-format": "{player} ({status}):\n{artist} - {title}",
        "status-icons": {
            "paused": "󰝛"
        },
        "ignored-players": [
            "firefox",
            "brave"
        ]
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "tooltip-format-activated": "Stay Awake: ON 󱎴",
        "tooltip-format-deactivated": "Stay Awake: OFF 󰶐",
        "format-icons": {
            "activated": "󱎴",
            "deactivated": "󰷛"
        }
    },
    "custom/updatespacman": {
        "format": "{}{icon}",
        "return-type": "json",
        "format-icons": {
            "has-updates": "󰏖",
            "updated": ""
        },
        "exec-if": "which waybar-module-pacman-updates",
        "exec": "waybar-module-pacman-updates --no-zero-output"
    },
    "tray": {
        "icon-size": 13,
        "spacing": 2
    },
    "custom/end-history": {
        "format": "通",
        "on-click": "~/.local/bin/end-rs history toggle",
        "tooltip-format": "Notification History"
    },
    "custom/updates": {
        "exec": "~/.local/bin/updates.sh",
        "interval": 1800,
        "on-click": "kitty -e sudo dnf upgrade",
        "format": "{}"
    }
}
