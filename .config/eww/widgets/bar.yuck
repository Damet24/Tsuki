(defvar my-json '[1, 2, 3, 4, 5]')
(defvar show_power_icons false)


;; Configuration
;; for further configuration see scripts/parse_workspaces.py
;; where you can set your icons

;; Enables process name preview on selected workspace
(defvar enable_process_name false)

;; Shows the workspace number beside the icon
(defvar enable_workspace_number false)

;; Enables multiple icon previews per workspace
(defvar enable_multiple_icons false)
(deflisten workspace_str
    :initial_value "{}"
    "$HOME/scripts/workspaces")

(defwidget bar []
    (box
        :class "bar"
        :orientation "v"
        :vexpand false
        :hexpand false

		(top)
		; (center)
        (end)
    )
)

(defwidget top []
	(box
	    :orientation "v"
		:space-evenly false
		:valign "start"

		(launcher)
		(workspaces)
	)
)

; (defwidget center []
; 	(box
; 	    :orientation "v"
; 		:space-evenly false
; 		:valign "center"

; 		(workspaces)
; 	)
; )


(defwidget end []
	(box
	    :orientation "v"
        :space-evenly false
        :valign "end"
        :spacing 5

		(bottom)
    )
)

(defwidget bottom []
	(box
	    :orientation "v"
		:space-evenly false

		(settings)
		(clock)
        (power)
    )
)

(defwidget launcher []
    (eventbox
        :cursor "pointer"
        :space-evenly false
        :halign "center"
        :valign "center"

        (box
            :class "launcher"
        )
    )
)

(defwidget clock []
    (eventbox
        :cursor "pointer"
        :space-evenly false
        :vexpand false
        :onclick "~/.config/eww/launch_bar_calendar"

        (box
            :class "clock_widget"
            :orientation "v"
            :space-evenly false
            :vexpand false
            :spacing 0
            :tooltip "${time_day_name}, ${time_month_name}, ${calendar_year}"

            (label :text time_hour)
            (label :text time_min)
        )
    )
)

(defwidget settings []
    (eventbox
        :cursor "pointer"
        :space-evenly false
        :vexpand false

        (label :text "")
    )
)

(defwidget power []
	(eventbox
	    :onhover "${eww} update show_power_icons=true"
		:onhoverlost "${eww} update show_power_icons=false"

		(box
		    :orientation "v"
			:space-evenly "false"
			:vexpand "false"
			:class "powermenu"

			(revealer
			    :transition "slideup"
				:reveal show_power_icons
				:duration "550ms"

				(box
				    :orientation "v"
					:space-evenly "false"

    	            (button
    					:class "button-bspres"
        				:tooltip "Hyperland Restart"
        				:onclick "hyprctl reload" ""
                    )

                   	(button
                        :class "button-reb"
                  		:tooltip "Reboot"
             			:onclick "reboot"	""
                    )

                   	(button
                  		:class "button-quit"
        				:tooltip "Logout"
        				:onclick "" ""
                    )

                   	(button
                  		:class "button-lock"
        				:tooltip "Lock Screen"
        				:onclick "hyprlock"	""
                    )
                )
			)

           	(button
               	:class "button-off"
               	:tooltip "Shutdown"
               	:onclick "shutdown now"	""
            )
        )
	)
)

(defwidget workspaces []
    (box
        :class "workspaces"
        :spacing 16
        :orientation "v"
        :space-evenly false
        :valign "center"
        :halign "center"

        (for workspace in "${workspace_str['icons']}"
            (eventbox
                :cursor "pointer"
                :onclick "hyprctl dispatch 'hl.dsp.focus({ workspace = '${workspace.workspace}' })'"

                (box
                    :spacing 10
                    :space-evenly false
                    :hexpand false
                    :vexpand false
                    :halign "center"
                    :valign "center"
                    :class "${workspace.current ? 'selected' : 'not-selected'}"

                    (for icon in
                        "${enable_multiple_icons ? '${workspace['icons']}' : '[${jq(workspace, '.icons[0]')}]'}"

                        (label
                            :class "icon"
                            :text "${icon}"
                            :tooltip "${workspace['process']}"
                        )
                    )
                )
            )
        )
    )
)
