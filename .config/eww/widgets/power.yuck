(defwidget porwerbuttons []
  (box
    :class "powerbuttons_container"
    :orientation "h"
    :spacing 15
    :valign "center"
    :halign "end"
    
    (button
      :class "powermenu_btn"
      :onclick "/usr/bin/hyprlock" "󰍁"
    )

    (button
      :class "powermenu_btn"
      :onclick "" "󰐥"
    )))

