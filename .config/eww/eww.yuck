(defvar IMAGE "~/.config/eww/images/profile.jpeg")
(defvar volume_visible false)
(defvar mic_visible false)

(defvar end-binary "~/.local/bin/end-rs")
(defpoll username :interval "48h"  "whoami")
(defpoll environment :interval "48h" "echo $XDG_CURRENT_DESKTOP")

(defpoll uptime :interval "50s" "uptime -p | sed -e 's/up //;s/ hours,/h/;s/ hour,/h/;s/ minutes/m/;s/ minute/m/'")

(defpoll time_hour :interval "5m" "date +\"%H\"")
(defpoll time_min :interval "5s" "date +\"%M\"")
(defpoll time_year :interval "5m" "date +\"%C\"")
(defpoll time_mer :interval "12h" "date +\"%p\"")
(defpoll time_day :interval "30m" "date +\"%d\"")
(defpoll time_month :interval "48h" "date +\%m")
(defpoll time_day_name :interval "30m" "date +\"%A\"")
(defpoll time_month_name :interval "48h" "date +\%B")

(defpoll calendar_day :interval "20h" "date '+%d'")
(defpoll calendar_year :interval "20h" "date '+%Y'")
(defpoll calendar_month :interval "20h" "date '+%m'")

(defpoll song :interval "1s"  "~/scripts/music_info --song")
(defpoll song_artist :interval "1s"  "~/scripts/music_info --artist")
(defpoll song_status :interval "1s"  "~/scripts/music_info --status")
(defpoll loop_status :interval "1s"  "~/scripts/music_info --loop_ic")
(defpoll song_time :interval "1s"  "~/scripts/music_info --time")
(defpoll song_cover :interval "1s"  "~/scripts/get_cover")

(defpoll battery :interval "15s" "~/scripts/battery --bat")
(defpoll memory :interval "15s" "~/scripts/memory")
(defpoll cpu :interval "17s" "~/scripts/cpu")

(defpoll wifi_icon :interval "15s" "~/scripts/wifi wifi")
(defpoll wifi_col :interval "15s" "~/scripts/wifi wifi_col")
(defpoll wifi_bg :interval "17s" "~/scripts/wifi wifi_bg")

(defpoll network_status :interval "5s" "~/scripts/network status")

(defpoll notif_icon :interval "15s" "~/scripts/notifs notifs")
(defpoll notif_col :interval "15s" "~/scripts/notifs notifs_col")
(defpoll notif_bg :interval "17s" "~/scripts/notifs notifs_bg")


(defpoll vol_icon :interval "15s" "~/scripts/vol vol")
(defpoll vol_col :interval "15s" "~/scripts/vol vol_col")
(defpoll vol_bg :interval "17s" "~/scripts/vol vol_bg")

(defpoll volume_percent
  :interval "0.1s"
  "wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2*100)}'")

(defpoll volume_muted
  :interval "0.1s"
"wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && echo true || echo false")

(defpoll mic_percent
  :interval "6s"
  "wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | awk '{print int($2*100)}'")


(defwindow main
  :namespace "main"

  :geometry (geometry
    :anchor "center bottom"
    :width "450px"
    :height "650px"
    :x "0px"
  :y "12px")
  :stacking "fg"
  :hexpand "false"
  :vexpand "false"
  (main))

(defwindow minimal
  :namespace "main"

  :geometry (geometry
    :anchor "center left"
    :width "450px"
    :height "650px"
    :x "12px"
    :y "50%")
  :stacking "fg"
  :hexpand "false"
  :vexpand "false"
  (main))

(defwindow system_power
  :namespace "system_power"

  :geometry (geometry
    :anchor "center"
    :width "100%"
    :height "110%"
    :x "0px"
    :y "0px")

  :stacking "overlay"

  (box
    :class "power_overlay"
    :halign "center"
    :valign "center"
    :hexpand true
    :vexpand true

    (box
      :class "power_menu"
      :orientation "v"
      :spacing 20

      (label
        :class "power_title"
        :text "Power Menu")

      (box
        :class "power_buttons"
        :orientation "h"
        :spacing 15

        (button
          :class "power_btn"
          :onclick "systemctl poweroff"
          "󰐥")

        (button
          :class "power_btn"
          :onclick "systemctl reboot"
          "󰜉")

        (button
          :class "power_btn"
          :onclick "hyprlock"
          "󰍁")

        (button
          :class "power_btn"
          :onclick "hyprctl dispatch exit"
          "󰗼")))))

(defwindow volume_osd
  :namespace "osd"

  :monitor 0
  :geometry (geometry
    :anchor "top center"
    :x "0px"
    :y "12px"
    :width "220px"
  :height "45px")
  :stacking "overlay"
  :focusable "none"
  :windowtype "dialog"
  :exclusive false
  (volume_osd_widget))

(defwidget main []
  (box
    :class "bg"
    :orientation "v"
    :space-evenly "false"
    
    (box
      :class "main_container"
      :orientation "v"
      :space-evenly "false"
      :spacing 15
      :vexpand "true"
      
      (box
        :orientation "h"
        :spacing 15
        :space-evenly "true"
        :class "container"
        
        (profile)
        (porwerbuttons))
      
      (box
        :orientation "v"
        :spacing 15
        :space-evenly "true"
        :class "container"
        
        (audio))
      
      (box
        :orientation "v"
        :spacing 15
        :space-evenly "true"
        :class "container"
        
        (music_panel)
      )
      
      (box
        :orientation "v"
        :spacing 15
        :space-evenly "false"
        :class "container"
        :vexpand "true"
        
        (network_status)

        (box :vexpand "true")

        (box
          :orientation "h"
          :space-evenly "false"
          :hexpand "true"
          :vexpand "false"

          (time_widget)
          (box :hexpand "true")
          (button 
            :class "silent_btn"
            :onclick "~/scripts/toggle_notifications" 
            "󰂛"
          )
        )
      )
    )
  ))

(defwindow music_player_window
  :namespace "music_player"

  :geometry (geometry
    :anchor "center bottom"
    :width "450px"
    :x "50%"
  :y "12px")
  :stacking "fg"
  :hexpand "false"
  :vexpand "false"

    (box
    :class "bg"
    :orientation "v"
    :space-evenly "false"

    (music_player)
  ))

(defwindow calendar_widget_window
  :namespace "music_player"

  :geometry (geometry
    :anchor "right bottom"
    :x "12px"
  :y "12px")
  :stacking "fg"
  :hexpand "false"
  :vexpand "false"

    (box
    :class "bg"
    :orientation "v"
    :space-evenly "false"

    (calendar_widget)
  ))




(include "widgets/profile.yuck")
(include "widgets/power.yuck")
(include "widgets/audio.yuck")
(include "widgets/music.yuck")
(include "widgets/time.yuck")
(include "widgets/network.yuck")
(include "widgets/end.yuck")
(include "widgets/music_player.yuck")
(include "widgets/calendar.yuck")

